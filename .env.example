# OpenAI-compatible local inference endpoint used by src/llm/refine.py.
# Copy this file to .env or export the variables in your shell; never commit
# the real key or a LAN-specific address in experiment YAML.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local-inference

# Keep the exact served model ID in the YAML config. Confirm it against your
# server's /v1/models response before launching a long benchmark.
